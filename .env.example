# Copy to .env (git-ignored). Never commit real values.
TEAM04_EMAIL=team04@theschoolofai.in
TEAM04_PASSWORD_SURYODAYA=
TEAM04_PASSWORD_KEYSTONE=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Optional: run the agent against a model on OpenRouter instead of OpenAI directly.
# Leave LLM_PROVIDER unset (or "openai") and nothing below is read. Set it to
# "openrouter" and both of the other two become required — there is no fallback to
# the OpenAI key, and no default slug, because "gpt-4.1" is not a valid OpenRouter id.
# OpenRouter ids are vendor/model, e.g. openai/gpt-4.1, anthropic/claude-sonnet-4.5.
# The model must support tool calling and a forced tool_choice, or the loop cannot
# make it record a finding before the step budget runs out.
LLM_PROVIDER=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional: pin "today" so runs are reproducible (YYYY-MM-DD). Defaults to the real date.
AGENT_TODAY=
